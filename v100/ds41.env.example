# Copy to ds41.env, edit, then: source ds41.env && v100/serve_ds41.sh --dry-run --strict
export DS41_MODEL=/path/to/ds41-franken-v100        # hf download philbert440/DeepSeek-V4.1-Flash-1017-EXL3-franken-v100
export DS41_ENGRAM_DIR=$DS41_MODEL                  # holds model-00047/48-of-00048.safetensors + their .sha256-ok sidecars
export DS41_PYTHON=/path/to/.venv/bin/python        # venv with the release wheel
export DS41_LOG_DIR=$PWD/logs
export DS41_SERVED_NAME=deepseek-v4.1-flash
export DS41_PORT=8000
# NVLink quads, one per pipeline stage (GPU indices or UUIDs):
export DS41_GPUS_A="0 1 2 3"
export DS41_GPUS_C="4 5 6 7"
